    "ignore_index": 255,
    "batch_size": 4,
    "epochs": 10,
    "seed": 7,
    "mixed_precision": true,
    "dataset": "CamVid",
    "training_images": 367,
    "validation_images": 101,
    "test_accessed": false,
    "device": "Tesla T4"
