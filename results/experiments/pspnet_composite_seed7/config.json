{
    "model": "pspnet",
    "encoder": "resnet18",
    "encoder_weights": "imagenet",
    "classes": 11,
    "input_size": [
        192,
        256
    ],
    "crop_mode": "none",
    "crop_size": [
        360,
        480
    ],
    "validation_crop_mode": "none",
    "optimizer": "AdamW",
    "learning_rate": 0.0001,
    "weight_decay": 0.0001,
    "loss": "composite",
